# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

default_platform(:ios)

platform :ios do
  APP_IDENTIFIER = "com.forsa-quran"
  XCODE_PROJECT = "forsa_quran.xcodeproj"
  XCODE_SCHEME = "forsa_quran"

  private_lane :app_store_connect_api_key_from_env do
    app_store_connect_api_key(
      key_id: ENV["APP_STORE_CONNECT_KEY_ID"],
      issuer_id: ENV["APP_STORE_CONNECT_ISSUER_ID"],
      key_content: ENV["APP_STORE_CONNECT_KEY_CONTENT"],
      is_key_content_base64: false
    )
  end

  private_lane :match_appstore_profile_name do
    mapping = lane_context[SharedValues::MATCH_PROVISIONING_PROFILE_MAPPING]
    profile_name = mapping&.fetch(APP_IDENTIFIER, nil)
    unless profile_name
      UI.user_error!(
        "No App Store provisioning profile for #{APP_IDENTIFIER}. " \
        "Match mapping: #{mapping.inspect}"
      )
    end
    profile_name
  end

  private_lane :prepare_app_store_build do |options|
    api_key = options[:api_key]

    # On CI only fetch existing certs/profiles; never create or rotate them
    # in the certificates repo from a build job.
    match(
      type: "appstore",
      api_key: api_key,
      readonly: is_ci
    )

    profile_name = match_appstore_profile_name

    update_code_signing_settings(
      use_automatic_signing: false,
      path: XCODE_PROJECT,
      code_sign_identity: "Apple Distribution",
      bundle_identifier: APP_IDENTIFIER,
      profile_name: profile_name,
      team_id: ENV["APPLE_TEAM_ID"]
    )

    build_app(scheme: XCODE_SCHEME)

    api_key
  end

  desc "Build a release IPA with App Store signing (no TestFlight upload)"
  lane :build do
    api_key = app_store_connect_api_key_from_env
    prepare_app_store_build(api_key: api_key)
  end

  desc "Build and upload a release build to TestFlight"
  lane :release do
    api_key = app_store_connect_api_key_from_env
    prepare_app_store_build(api_key: api_key)

    upload_to_testflight(
      api_key: api_key
    )
  end
end
